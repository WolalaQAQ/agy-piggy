{
  "agy-piggy": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./src/hook.mjs",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./src/hook.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./src/hook.mjs",
        "timeout": 5
      }
    ]
  }
}
